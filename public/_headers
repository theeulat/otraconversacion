/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; frame-ancestors 'self'; upgrade-insecure-requests

# Los nombres de imagen y de tipografia no cambian, y si cambia el contenido
# cambia el nombre. Se pueden guardar para siempre.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# CSS y JS llevan huella de contenido en la consulta, asi que un despliegue
# nuevo invalida la copia guardada.
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/feed/*
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600

/buscar-es.json
  Cache-Control: public, max-age=3600

/buscar-en.json
  Cache-Control: public, max-age=3600

/*.html
  Cache-Control: public, max-age=0, must-revalidate
